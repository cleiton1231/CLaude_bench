#!/usr/bin/env python3
"""Executável que se passa por llama-server nos testes dos scripts: aceita as mesmas flags,
responde --help e sobe o servidor falso na porta pedida."""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

if "--help" in sys.argv:
    print("--jinja\n-fa, --flash-attn [on|off|auto]\n--port N")
    sys.exit(0)
ap = argparse.ArgumentParser()
ap.add_argument("--port", type=int, default=8080)
ap.add_argument("--model")
a, _ = ap.parse_known_args()
if not Path(a.model or "").exists():
    print(f"erro: modelo não encontrado: {a.model}", file=sys.stderr)
    sys.exit(1)
from tests.servidor_falso import Servidor  # noqa: E402
s = Servidor(porta=a.port)
print(f"servidor falso em {s.url}", flush=True)
s.http.serve_forever()
